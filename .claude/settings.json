{
  "permissions": {
    "defaultMode": "default",
    "blockReadsOutsideWorkingDirectories": true,
    "deny": [
      "Read(/**/.env)",
      "Read(/**/.env.*)",
      "Read(/**/secrets/**)",
      "Read(/**/.data/**)",
      "Read(/**/data/**)",
      "Read(/**/.private/**)",
      "Read(/**/.local/**)",
      "Read(/**/backups/**)",
      "Read(/**/exports/**)",
      "Read(/**/uploads/**)",
      "Read(/**/logs/**)",
      "Read(/**/screenshots/**)",
      "Read(/**/artifacts/**)",
      "Read(/**/test-results/**)",
      "Read(/**/playwright-report/**)",
      "Read(/**/.codex/**)",
      "Read(/**/.claude/settings.local.json)",
      "Read(/**/CLAUDE.local.md)",
      "Read(/**/AGENTS.override.md)",
      "Read(/**/*.db*)",
      "Read(/**/*.sqlite*)",
      "Read(/**/*.pem)",
      "Read(/**/*.key)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.codex/**)",
      "Read(~/.claude/**)",
      "Read(~/.claude.json)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git commit *)",
      "Bash(npm install *)",
      "Bash(npm publish *)",
      "Bash(gh repo *)",
      "Bash(docker push *)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [],
    "filesystem": {
      "denyRead": ["~/", "**/.env", "**/.env.*", "**/data", "**/.data", "**/secrets", "**/.private", "**/.local", "**/backups", "**/exports", "**/uploads", "**/logs", "**/.codex", "**/*.db*", "**/*.sqlite*", "**/*.pem", "**/*.key"],
      "allowRead": ["."]
    },
    "network": {
      "allowedDomains": [],
      "allowLocalBinding": false,
      "allowAllUnixSockets": false
    }
  }
}
