{
  "permissions": {
    "defaultMode": "default",
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./secrets/**)",
      "Read(./.data/**)",
      "Read(./data/**)",
      "Read(./.private/**)",
      "Read(./backups/**)",
      "Read(./exports/**)",
      "Read(./.codex/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.codex/auth.json)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git commit *)",
      "Bash(npm install *)",
      "Bash(npm publish *)",
      "Bash(gh repo *)",
      "Bash(docker push *)"
    ]
  }
}
